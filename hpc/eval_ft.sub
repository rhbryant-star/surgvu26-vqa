universe = vanilla
executable = eval_ft.sh
log    = evalft_$(Cluster).log
output = evalft_$(Cluster).out
error  = evalft_$(Cluster).err

request_cpus = 4
request_memory = 48GB
request_disk = 30GB
request_gpus = 1
# bf16 7B (~16 GB weights) + the non-flash vision-tower attention burst (~14 GB
# for 8 frames) OOMs a 40 GB A100 — require a >=70 GB GPU (H200, bhaskar priority).
requirements = (CUDAGlobalMemoryMb >= 70000)
rank = (Machine == "bhaskargpu4000.chtc.wisc.edu") * 1000
+WantStagingMount = true

transfer_input_files = ../scripts/predict_samples.py, ../surgvu_vqa
transfer_output_files = predictions_base_bf16.json, predictions_base_bf16_raw.json, predictions_ft_bf16.json, predictions_ft_bf16_raw.json
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
queue
